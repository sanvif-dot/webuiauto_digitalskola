{
    "name": "selenium-mocha-digital-skola",
    "version": "1.0.0",
    "type": "module",
    "description": "Selenium WebDriver tests using Mocha with Mochawesome reports",
    "scripts": {
    "test": "mocha tests/test-sauce.js --recursive --timeout 60000",
    "script_tugas": "mocha tests/tugas-webui.js --recursive --timeout 60000",
    "script_hooks": "mocha tests/tugas-hooks.js --recursive --timeout 60000",
    "script_pom": "mocha tests/tugas-pom.js --recursive --timeout 60000",
    "screenshot": "mocha tests/screenshot.js --recursive --timeout 60000",
    "report-mochawesome": "mocha tests --recursive --timeout 60000 --reporter mochawesome --reporter-options output=reports_hooks",
    "report-simple-html": "mocha tests --recursive --timeout 60000 --reporter mocha-simple-html-reporter --reporter-options output=report_hooks.html"
    },
    "dependencies": {
      "pixelmatch": "^7.1.0",
      "pngjs": "^7.0.0",
      "selenium-webdriver": "^4.17.0"
    },
    "devDependencies": {
      "mocha": "^10.4.0",
      "mocha-simple-html-reporter": "^2.0.0",
      "mochawesome": "^7.1.3"
        }
  }