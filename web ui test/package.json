{
    "name": "selenium-mocha-digital-skola",
    "version": "1.0.0",
    "description": "Selenium WebDriver tests using Mocha with Mochawesome reports",
    "scripts": {
    "test": "mocha tests/test-sauce.js --recursive --timeout 60000",
    "script_tugas": "mocha tests/tugas-webui.js --recursive --timeout 60000",
    "report-mochawesome": "mocha tests/tugas-webui.js --recursive --timeout 60000 --reporter mochawesome",
    "report-simple-html": "mocha tests/tugas-webui.js --recursive --timeout 60000 --reporter mocha-simple-html-reporter --reporter-options output=report.html"
    },
    "dependencies": {
      "selenium-webdriver": "^4.17.0"
    },
    "devDependencies": {
      "mocha": "^10.4.0",
      "mochawesome": "^7.1.3",
      "mocha-simple-html-reporter": "^2.0.0"
    }
  }